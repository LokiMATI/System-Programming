<Window x:Class="LabApp.StartProcessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabApp"
        mc:Ignorable="d"
        Title="StartProcessWindow" Height="450" Width="800">
    <StackPanel>
        <TextBox Name="ProcessTextBox"/>
        <StackPanel Orientation="Horizontal">
            <Button Name="OkButton" Content="ОК" Click="OkButton_Click"/>
            <Button Name="SearchButton" Content="Обзор" Click="SearchButton_Click"/>
            <Button Name="CancleButton" Content="Отмена"/>
        </StackPanel>
    </StackPanel>
</Window>
