<Window x:Class="WindowApp.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowApp"
        mc:Ignorable="d"
        Title="ChatWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBox Name="MessageTextBox" Height="50"/>
            <Button Name="SendButton" Content="Отправить" Click="SendButton_Click"/>
        </StackPanel>
        <TextBlock Name="ChatTextBlock"/>
    </DockPanel>
</Window>
