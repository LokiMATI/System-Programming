<Window x:Class="LabApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="Процессор">
                <Grid Background="#FFE5E5E5">
                    <ScrollViewer>
                        <TextBlock Name="ProcessesTextBlock"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            
            <TabItem Header="Видеокарта">
                <Grid Background="#FFE5E5E5">
                    <ScrollViewer>
                        <TextBlock Name="VideoCardsTextBlock"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            
            <TabItem Header="Материнская плата">
                <Grid Background="#FFE5E5E5">
                    <ScrollViewer>
                        <TextBlock Name="MotherBoardsTextBlock"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            
            <TabItem Header="Физические диски">
                <Grid Background="#FFE5E5E5">
                    <ScrollViewer>
                        <TextBlock Name="HardDrivesTextBlock"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            
            <TabItem Header="Операционная система">
                <Grid Background="#FFE5E5E5">
                    <ScrollViewer>
                        <TextBlock Name="OperationsSystemsTextBlock"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            
            <TabItem Header="Сеть">
                <Grid Background="#FFE5E5E5">
                    <ScrollViewer>
                        <TextBlock Name="NetworkTextBlock"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Установленные программы">
                <Grid Background="#FFE5E5E5">
                    <ScrollViewer>
                        <TextBlock Name="ProgramsTextBlock"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
